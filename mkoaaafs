#!/bin/bash
# mkoaaafs - odd and atomic arch System Image Build Tool - based on mkobsidiansfs with all the fat cut down and hardcoded
# Copyright 2025 ObsidianOS and ObsidianOS contributors under the MIT Licence
set -eu
check_command() {
  local cmd="$1"
  local extra_msg="$2"
  if ! command -v "$cmd" &>/dev/null; then
    echo "Error: Required command '$cmd' not found. Please install it."
    [[ -n "$extra_msg" ]] && echo "$extra_msg"
    exit 1
  fi
}
if [[ $EUID -ne 0 ]]; then echo "This script must be run as root.";exit 1;fi
cd "$(dirname "$(realpath "$0")")"
check_command mkfs.erofs "mkfs.erofs is provided by erofs-utils on Arch Linux"
check_command pacstrap "pacstrap is part of the arch-install-scripts package on Arch Linux."
check_command arch-chroot "arch-chroot is part of the arch-install-scripts package on Arch Linux."
check_command fuser "fuser is provided by psmisc on Arch Linux"

# Kill anything still chrooted/running under oaaa_rootfs (e.g. gpg-agent
# left behind by pacman/makepkg) and unmount everything under it, retrying
# since orphaned processes can otherwise keep /proc etc. "busy" for every
# later arch-chroot call.
kill_procs_under() {
  local dir; dir="$(realpath -m "$1")"
  local pid target link fd
  for pid in /proc/[0-9]*; do
    pid="${pid#/proc/}"
    for link in cwd exe root; do
      target=$(readlink -f "/proc/$pid/$link" 2>/dev/null) || continue
      case "$target" in
        "$dir"|"$dir"/*) kill -9 "$pid" 2>/dev/null; continue 2 ;;
      esac
    done
    for fd in /proc/"$pid"/fd/*; do
      target=$(readlink -f "$fd" 2>/dev/null) || continue
      case "$target" in
        "$dir"|"$dir"/*) kill -9 "$pid" 2>/dev/null; break ;;
      esac
    done
  done
  return 0
}

cleanup_rootfs() {
  local dir="$1" tries=0
  [[ -d "$dir" ]] || return 0
  kill_procs_under "$dir"
  while findmnt -Rn -o TARGET "$dir" &>/dev/null && (( tries < 15 )); do
    findmnt -Rn -o TARGET "$dir" | sort -r | xargs -r umount -l 2>/dev/null
    tries=$((tries + 1))
    sleep 1
  done
}

cleanup_rootfs "$(realpath -m oaaa_rootfs)"; rm -rf "oaaa_rootfs"; rm -f "system.erofs"; mkdir -p "oaaa_rootfs"
mount --bind "oaaa_rootfs" "oaaa_rootfs"
pacstrap -c -K "oaaa_rootfs" base linux linux-firmware linux-headers grub efibootmgr os-prober networkmanager iwd openssh curl wget dosfstools e2fsprogs f2fs-tools gptfdisk erofs-utils squashfs-tools pv sudo base-devel git arch-install-scripts python vim nano gpm man-db man-pages htop pipewire pipewire-pulse pipewire-alsa wireplumber plasma-meta sddm konsole dolphin kate xdg-user-dirs xdg-utils noto-fonts noto-fonts-emoji ttf-dejavu firefox bc btop tmux zsh flatpak discover xdg-desktop-portal appstream packagekit-qt6 xdg-desktop-portal-kde gum

# pacstrap's transaction runs under the HOST's own pacman config, and on some
# base images that config's NoExtract rules end up skipping the pacman/pacman.d
# config files entirely inside the target - guard against that directly rather
# than trusting the transaction always left a usable config behind, since a
# missing pacman.conf silently breaks every later pacman/makepkg call in the
# chroot (e.g. the yay-bin build below).
if [[ ! -f "oaaa_rootfs/etc/pacman.conf" ]]; then
  echo "Warning: oaaa_rootfs/etc/pacman.conf missing after pacstrap, writing a default."
  if [[ -f /etc/pacman.conf ]]; then
    cp /etc/pacman.conf "oaaa_rootfs/etc/pacman.conf"
  else
    cat > "oaaa_rootfs/etc/pacman.conf" <<'PACMANCONF'
[options]
HoldPkg     = pacman glibc
Architecture = auto
Color
CheckSpace
ParallelDownloads = 5
SigLevel    = Required DatabaseOptional
LocalFileSigLevel = Optional

[core]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist
PACMANCONF
  fi
fi
mkdir -p "oaaa_rootfs/etc/pacman.d"
if [[ ! -s "oaaa_rootfs/etc/pacman.d/mirrorlist" ]]; then
  echo "Warning: oaaa_rootfs/etc/pacman.d/mirrorlist missing/empty after pacstrap, writing a default."
  if [[ -s /etc/pacman.d/mirrorlist ]]; then
    cp /etc/pacman.d/mirrorlist "oaaa_rootfs/etc/pacman.d/mirrorlist"
  else
    echo 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' > "oaaa_rootfs/etc/pacman.d/mirrorlist"
  fi
fi

arch-chroot "oaaa_rootfs" useradd -m -G wheel -s /bin/bash "oobe" 2>/dev/null|true
arch-chroot "oaaa_rootfs" sh -c "echo '%wheel ALL=(ALL) NOPASSWD: ALL'>>/etc/sudoers" 2>/dev/null|true
arch-chroot "oaaa_rootfs" visudo -c 2>/dev/null|true
arch-chroot "oaaa_rootfs" passwd -d oobe 2>/dev/null|true
arch-chroot "oaaa_rootfs" mkdir -p /etc/systemd/system/getty@tty1.service.d
arch-chroot "oaaa_rootfs" tee /etc/systemd/system/getty@tty1.service.d/autologin.conf > /dev/null << 'EOF'
[Service]
ExecStart=
ExecStart=-/usr/bin/agetty --autologin oobe --noclear %I $TERM
EOF
arch-chroot "oaaa_rootfs" sh -c "cat > /home/oobe/install-yay.sh" <<'EOF'
#!/bin/bash
cd ~
git clone --branch yay-bin --single-branch https://github.com/archlinux/aur.git yay-bin
cd yay-bin
makepkg --noconfirm --skippgpcheck -si
cd ..
rm -rf yay-bin
sudo rm install-yay.sh
EOF
arch-chroot "oaaa_rootfs" chmod +x /home/oobe/install-yay.sh
arch-chroot -u oobe "oaaa_rootfs" env HOME=/home/oobe /home/oobe/install-yay.sh
if [ "$#" -ge 1 ]; then
  arch-chroot -u oobe "oaaa_rootfs" env HOME=/home/oobe yay -S "$@" --noconfirm
fi
arch-chroot "oaaa_rootfs" tee -a /home/oobe/.bashrc > /dev/null << 'ENDBASHRC'
if ! [ -e ~/.oaaa-firstboot ]; then
  choose() {
    gum choose --header.foreground="" --selected.foreground="" --cursor.foreground="" --no-show-help --header=""
  }
  sleep 10
  while true; do
    choices="Set up your user\nShell\nRoot Shell\nManual Setup\n"
    if mountpoint -q /oaaa 2>/dev/null; then
      choices="${choices}Load OAAAT\nReboot to OAAAT\n"
    fi
    choices="${choices}Reboot\nShutdown\n"
    choice="$(printf "$choices"|choose)"
    if [ "$choice" = "Set up your user" ]; then
      clear
      echo "Welcome to oaaa! - OOBE - User - Username"
      printf "Choose a username: "
      read NEW
      [ -z "$NEW" ] && { echo "Choosing default: user"; NEW=user; }
      clear
      echo "Welcome to oaaa! - OOBE - User - Password"
      echo "Please choose a password for your user account:"
      sudo passwd oobe
      clear
      echo "Welcome to oaaa! - OOBE - User - Admin Password"
      echo "Please choose a password for the admin (root) account:"
      sudo passwd
      clear
      echo "Welcome to oaaa! - OOBE - Networking"
      read -r -p "Would you like to connect to/configure the internet? [Y/n] " response
      if ! [[ "$response" =~ ^([Nn][oO]|[Nn])$ ]]; then
        nmtui
      fi
      clear
      echo "Welcome to oaaa! - OOBE - Configuring"
      echo "_______________________________________________________________________________"
      echo "[fancy user setup happening... please wait! This will take less than a minute.]"
      echo "[after the user setup, the system will reboot.________________________________]"
      sudo systemctl enable plasmalogin
      sudo chsh -s /usr/bin/zsh oobe
      sudo rm -rf /etc/systemd/system/getty@tty1.service.d
      touch ~/.oaaa-firstboot
      sudo mv /home/oobe "/home/$NEW"
      sudo sed -i "s|oobe|$NEW|g" /etc/passwd /etc/shadow /etc/group /etc/gshadow
      sudo systemctl reboot 2>/dev/null >/dev/null
      sleep infinity
    elif [ "$choice" = "Shell" ]; then
      break
    elif [ "$choice" = "Root Shell" ]; then
      sudo su
    elif [ "$choice" = "Manual Setup" ]; then
      echo "Are you sure? This will rename your account to 'user', disable the OOBE, and drop you into a root shell."
      if [ "$(printf 'Cancel\nYes\n'|choose)" = "Yes" ]; then
        sudo rm -rf /etc/systemd/system/getty@tty1.service.d
        touch ~/.oaaa-firstboot
        sudo mv /home/oobe /home/user
        sudo sed -i "s|oobe|user|g" /etc/passwd /etc/shadow /etc/group /etc/gshadow
        exec sudo su
      fi
    elif [ "$choice" = "Load OAAAT" ]; then
      sudo /oaaa/oaaat
    elif [ "$choice" = "Reboot to OAAAT" ]; then
      sudo /oaaa/boot-to-oaaat
    elif [ "$choice" = "Reboot" ]; then
      sudo reboot
    elif [ "$choice" = "Shutdown" ]; then
      sudo shutdown now
    fi
  done
fi
ENDBASHRC
arch-chroot "oaaa_rootfs" systemctl enable NetworkManager gpm 2>/dev/null|true
arch-chroot "oaaa_rootfs" flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
cleanup_rootfs "oaaa_rootfs"
mkfs.erofs -z zstd -x-1 system.erofs "oaaa_rootfs"
cleanup_rootfs "oaaa_rootfs"
rm -rf "oaaa_rootfs"

