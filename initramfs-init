#!/bin/sh
# oaaa initramfs init - two-stage boot via kexec
# stage 1: builds a one-time-use stage2 initramfs in /tmp with modules baked in, kexecs EROFS kernel
# stage 2: loads embedded modules, mounts overlay, switch_roots

# mounts the ESP (partition 1 on the same disk as OAAA_DATA, partition 2) at
# /boot - derived from the data device's own name rather than probed
# separately, since we already know it works for finding OAAA_DATA and this
# avoids depending on busybox blkid's (unreliable) GPT partition-type support.
mount_esp() {
  data_dev="$1"
  esp_dev="$(echo "$data_dev" | sed 's/[0-9]*$/1/')"
  mkdir -p /boot
  if mount -t vfat "$esp_dev" /boot 2>/dev/null; then
    echo "[oaaa] ESP mounted at /boot ($esp_dev)"
  else
    echo "[oaaa] WARNING: could not mount ESP ($esp_dev) at /boot"
  fi
}

# runs every *.sh under /data/plugins/<stage>, in glob (lexical) order, each
# as its own subshell - isolated on purpose, so a broken plugin can't corrupt
# this script's own variables/state (a crash here means an unbootable
# system). persistent by default (not one-shot); a plugin that wants to run
# only once can `rm "$0"` as its own last line.
run_plugins() {
  dir="$1"
  [ -d "$dir" ] || return 0
  for f in "$dir"/*.sh; do
    [ -f "$f" ] || continue
    echo "[oaaa] plugin: $(basename "$f")"
    sh "$f"
  done
}

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
exec > /dev/console 2>&1
exec < /dev/console

if grep -q "oaaa.stage=2" /proc/cmdline 2>/dev/null; then
  # ---- STAGE 2 ----
  echo "[oaaa] stage 2: loading embedded modules..."
  # suppress kernel noise so our output is visible
  echo 1 > /proc/sys/kernel/printk

  # modules were baked directly into this initramfs by stage 1 (see /lib/modules
  # below), so no disk needs to be found/mounted before they're available -
  # this avoids the nvme chicken-and-egg problem entirely.
  # load everything embedded, not just a fixed list, since we can afford it now.
  # insmod doesn't resolve dependency order like modprobe does, so keep
  # retrying passes over the remaining modules until a full pass makes no
  # progress (either everything loaded, or what's left genuinely can't load).
  # every insmod is timeout-wrapped so one hanging module (e.g. a hardware
  # accelerator driver probing for nonexistent hardware) can't stall boot forever.
  ALL_MODS=$(find /lib/modules -name "*.ko" 2>/dev/null)
  LOADED=0
  TOTAL=$(echo "$ALL_MODS" | grep -c . 2>/dev/null)
  echo "[oaaa] found $TOTAL modules to load"
  LOAD_ORDER=""

  # stage 1 copies a previous successful boot's load order into /modorder if
  # one exists on OAAA_DATA - try that first, in order, single pass, before
  # falling back to full blind multi-pass retry for anything left over.
  MOD_LIST="$ALL_MODS"
  if [ -f /modorder ]; then
    echo "[oaaa] trying cached module order from previous boot..."
    CACHED=$(cat /modorder)
    CTOTAL=$(echo "$CACHED" | grep -c . 2>/dev/null)
    CI=0
    for ko in $CACHED; do
      CI=$((CI + 1))
      [ -f "$ko" ] || continue
      name=$(basename "$ko" .ko)
      if timeout -s KILL 5 insmod "$ko" 2>/dev/null; then
        LOADED=$((LOADED + 1))
        LOAD_ORDER="$LOAD_ORDER
$ko"
        echo "[oaaa]   ($CI/$CTOTAL) cached ok: $name"
        MOD_LIST=$(echo "$MOD_LIST" | tr ' ' '\n' | grep -vFx "$ko" | tr '\n' ' ')
      else
        echo "[oaaa]   ($CI/$CTOTAL) cached fail/timeout: $name (will retry below)"
      fi
    done
  fi

  PREV_REMAINING=-1
  PASS=0
  while [ -n "$MOD_LIST" ]; do
    PASS=$((PASS + 1))
    echo "[oaaa] --- pass $PASS ---"
    REMAINING=""
    ATTEMPTED=0
    PASS_TOTAL=$(echo "$MOD_LIST" | wc -w)
    for ko in $MOD_LIST; do
      ATTEMPTED=$((ATTEMPTED + 1))
      name=$(basename "$ko" .ko)
      if timeout -s KILL 5 insmod "$ko" 2>/dev/null; then
        LOADED=$((LOADED + 1))
        LOAD_ORDER="$LOAD_ORDER
$ko"
        echo "[oaaa]   ($ATTEMPTED/$PASS_TOTAL) ok: $name"
      else
        REMAINING="$REMAINING $ko"
      fi
    done
    REMAINING_COUNT=$(echo "$REMAINING" | wc -w)
    echo "[oaaa] pass $PASS done, loaded so far: $LOADED, remaining: $REMAINING_COUNT"
    [ "$REMAINING_COUNT" -eq "$PREV_REMAINING" ] && break
    PREV_REMAINING=$REMAINING_COUNT
    MOD_LIST="$REMAINING"
  done
  echo "[oaaa] loaded $LOADED/$TOTAL modules (rest may already be built-in, unneeded, or timed out)"

  # restore printk
  echo 7 > /proc/sys/kernel/printk

  # now that any needed storage/fs modules are loaded, find OAAA_DATA
  echo "[oaaa] scanning for OAAA_DATA..."
  DATA_DEV=""
  for i in $(seq 1 30); do
    DATA_DEV=$(blkid 2>/dev/null | grep 'LABEL="OAAA_DATA"' | head -1 | cut -d: -f1)
    [ -n "$DATA_DEV" ] && break
    echo "[oaaa] waiting for OAAA_DATA ($i/30)..."
    sleep 1
  done
  echo "[oaaa] data dev: $DATA_DEV"
  if [ -n "$DATA_DEV" ]; then
    mkdir -p /data
    mount -t ext4 "$DATA_DEV" /data 2>/dev/null
    # keep data mounted - we need it for images below
    # write out this boot's successful load order so stage 1 can seed it
    # into next boot's initramfs as a fast-path cache
    echo "$LOAD_ORDER" | grep -v '^$' > /data/oaaa-modorder 2>/dev/null
    mount_esp "$DATA_DEV"
    # keep /data/oaaat in sync with whatever oaaat shipped in this initramfs,
    # so the booted system always has the latest version without needing a
    # separate update step for it specifically.
    cp /bin/oaaat /data/oaaat 2>/dev/null && chmod +x /data/oaaat
  else
    echo "[oaaa] FATAL: OAAA_DATA not found"
    exec setsid cttyhack sh
  fi

  echo "[oaaa] stage 2: setting up overlay..."

  # ensure loop device nodes exist
  for i in 0 1 2 3 4 5 6 7; do
    [ -e "/dev/loop$i" ] || mknod "/dev/loop$i" b 7 "$i" 2>/dev/null
  done

  NEWEST=$(ls -t /data/images/*.erofs 2>/dev/null | head -1)
  [ -z "$NEWEST" ] && { echo "[oaaa] FATAL: no erofs images"; exec setsid cttyhack sh; }
  echo "[oaaa] image: $(basename "$NEWEST")"

  # debug: check what's registered
  echo "[oaaa] fs: $(grep erofs /proc/filesystems 2>/dev/null || echo 'erofs NOT in /proc/filesystems')"
  echo "[oaaa] loop: $(grep loop /proc/modules 2>/dev/null | head -1 || echo 'loop NOT in /proc/modules')"

  mkdir -p /erofs
  mount -t erofs -o ro "$NEWEST" /erofs || { echo "[oaaa] FATAL: cannot mount erofs"; exec setsid cttyhack sh; }

  mkdir -p /data/overlay/upper /data/overlay/work /overlay

  mount -t overlay overlay \
    -o lowerdir=/erofs,upperdir=/data/overlay/upper,workdir=/data/overlay/work,index=off \
    /overlay || { echo "[oaaa] FATAL: overlayfs failed"; exec setsid cttyhack sh; }
  echo "[oaaa] overlay ready, switching root..."

  if [ -f "/data/oaaa-command-stage2" ]; then
    sh /data/oaaa-command-stage2
    rm /data/oaaa-command-stage2
  fi
  run_plugins /data/plugins/stage2

  echo "[oaaa] thanks for using oaaa!"
  if grep -q "oaaa.shell=2" /proc/cmdline 2>/dev/null; then
    echo "[oaaa] dropping to stage 2 shell (oaaa.shell=2)"
    echo "[oaaa] modules loaded, erofs at /erofs, overlay at /overlay, data at /data"
    exec setsid cttyhack sh
  fi

  mkdir -p /overlay/oaaa
  mount --bind /data /overlay/oaaa

  mkdir -p /overlay/boot
  grep -q ' /boot ' /proc/mounts 2>/dev/null && mount --move /boot /overlay/boot

  mkdir -p /overlay/proc /overlay/sys /overlay/dev
  mount --move /proc /overlay/proc
  mount --move /sys /overlay/sys
  mount --move /dev /overlay/dev

  if [ -f "/data/oaaa-command-preboot" ]; then
    sh /data/oaaa-command-preboot
    rm /data/oaaa-command-preboot
  fi
  run_plugins /data/plugins/preboot

  exec switch_root /overlay /sbin/init

else
  # ---- STAGE 1 ----
  echo "[oaaa] stage 1: starting..."
  sleep 1

  DATA_DEV=$(blkid 2>/dev/null | grep 'LABEL="OAAA_DATA"' | head -1 | cut -d: -f1)
  [ -z "$DATA_DEV" ] && { echo "[oaaa] FATAL: no OAAA_DATA"; exec setsid cttyhack sh; }
  echo "[oaaa] data: $DATA_DEV"

  mkdir -p /data
  mount -t ext4 "$DATA_DEV" /data || { echo "[oaaa] FATAL: cannot mount data"; exec setsid cttyhack sh; }
  mount_esp "$DATA_DEV"

  if [ -f "/data/oaaa-factory-reset" ]; then
    echo "[oaaa] pending factory reset - wiping overlay upper..."
    rm -rf "/data/overlay/upper"
    rm -f "/data/oaaa-factory-reset"
  fi
  if [ -f "/data/oaaa-cleanup" ]; then
    echo "[oaaa] pending cleanup reset - wiping overlay upper except /home and /etc..."
    find "/data/overlay/upper" -mindepth 1 -maxdepth 1 ! -name home ! -name etc -exec rm -rf {} + 2>/dev/null
    rm -f "/data/oaaa-cleanup"
  fi
  if [ -f "/data/oaaa-command-stage1" ]; then
    sh /data/oaaa-command-stage1
    rm /data/oaaa-command-stage1
  fi
  run_plugins /data/plugins/stage1
  echo "[oaaa] thanks for using oaaa!"
  if grep -q "oaaa.shell=1" /proc/cmdline 2>/dev/null; then
    echo "[oaaa] dropping to stage 1 shell (oaaa.shell=1)"
    exec setsid cttyhack sh
  fi
  NEWEST=$(ls -t /data/images/*.erofs 2>/dev/null | head -1)
  [ -z "$NEWEST" ] && { echo "[oaaa] FATAL: no erofs images"; exec setsid cttyhack sh; }

  mkdir -p /erofs
  mount -t erofs -o ro "$NEWEST" /erofs || { echo "[oaaa] FATAL: cannot mount erofs"; exec setsid cttyhack sh; }

  KVER=$(ls /erofs/lib/modules/ 2>/dev/null | head -1)
  echo "[oaaa] EROFS kernel: $KVER"

  # build a one-time-use stage2 initramfs in /tmp with modules baked directly
  # in, instead of writing modules to the data partition and relying on
  # stage2 being able to read them back from disk (chicken-and-egg for nvme etc)
  echo "[oaaa] building dynamic stage2 initramfs in /tmp..."
  rm -rf /tmp/initramfs-build
  mkdir -p /tmp/initramfs-build
  (cd /tmp/initramfs-build && zcat /data/initramfs-oaaa.img | cpio -idm 2>/dev/null)

  # swap the stage1 marker for a stage2 one - this is the only place stage2's
  # initramfs is assembled, so it's the right spot to stamp it as such
  rm -f /tmp/initramfs-build/etc/oaaa-stage1
  mkdir -p /tmp/initramfs-build/etc
  touch /tmp/initramfs-build/etc/oaaa-stage2

  # seed a previous successful boot's module load order in, if we have one,
  # so stage 2 can try it as a fast path instead of blind multi-pass retry
  if [ -f /data/oaaa-modorder ]; then
    cp /data/oaaa-modorder /tmp/initramfs-build/modorder
    echo "[oaaa] seeded cached module order into stage2 initramfs"
  fi

  mkdir -p "/tmp/initramfs-build/lib/modules/$KVER"
  # only embed disk/filesystem-relevant modules, not the entire kernel module
  # tree - this is an early-boot initramfs, it doesn't need network, sound,
  # gpu, bluetooth, etc drivers. keep storage controllers (nvme/ata/scsi/block/
  # md), virtio (needed for QEMU virtio-blk/scsi, not "network" even though
  # it's virtualization-adjacent), filesystems, and their crypto/lib deps.
  MOD_ALLOWLIST='kernel/drivers/nvme/|kernel/drivers/ata/|kernel/drivers/scsi/|kernel/drivers/block/|kernel/drivers/md/|kernel/drivers/virtio/|kernel/drivers/usb/storage/|kernel/drivers/hid/|kernel/drivers/input/|kernel/fs/|kernel/lib/|kernel/crypto/'
  find "/erofs/lib/modules/$KVER" -name "*.ko.zst" 2>/dev/null | grep -E "$MOD_ALLOWLIST" | while read f; do
    name=$(basename "$f" .zst)
    zstd -d "$f" -o "/tmp/initramfs-build/lib/modules/$KVER/$name" 2>/dev/null && echo "[oaaa] embedded $name"
  done
  find "/erofs/lib/modules/$KVER" -name "*.ko" 2>/dev/null | grep -E "$MOD_ALLOWLIST" | while read f; do
    cp "$f" "/tmp/initramfs-build/lib/modules/$KVER/"
  done
  echo "[oaaa] modules embedded: $(ls "/tmp/initramfs-build/lib/modules/$KVER"/*.ko 2>/dev/null | wc -l) files (disk/fs-relevant only, out of $(find "/erofs/lib/modules/$KVER" \( -name '*.ko' -o -name '*.ko.zst' \) 2>/dev/null | wc -l) total)"

  echo "[oaaa] packing dynamic initramfs..."
  (cd /tmp/initramfs-build && find . | cpio -H newc -o 2>/dev/null | gzip > /tmp/initramfs-oaaa-dynamic.img)
  echo "[oaaa] dynamic initramfs: $(du -sh /tmp/initramfs-oaaa-dynamic.img 2>/dev/null | cut -f1)"

  # propagate a requested stage 2 shell drop through the kexec, so a
  # "Shell (Stage 2)" boot still goes through the real kexec transition
  # and has actual modules loaded, instead of skipping straight to stage 2
  # code under the stage 1 kernel's own (module-less) initramfs.
  SHELL2_FLAG=""
  grep -q "oaaa.shell=2" /proc/cmdline 2>/dev/null && SHELL2_FLAG=" oaaa.shell=2"

  echo "[oaaa] kexecing to EROFS kernel..."
  kexec -l /erofs/boot/vmlinuz-linux \
    --initrd=/tmp/initramfs-oaaa-dynamic.img \
    --append="console=tty0 console=ttyS0,115200 oaaa.stage=2$SHELL2_FLAG" || { echo "[oaaa] FATAL: kexec failed"; exec setsid cttyhack sh; }

  if [ -f "/data/oaaa-command-pre2" ]; then
    sh /data/oaaa-command-pre2
    rm /data/oaaa-command-pre2
  fi
  run_plugins /data/plugins/pre2

  umount /erofs /data /boot 2>/dev/null

  # unbind USB HCDs before kexec - active DMA from xhci/ehci will cause kexec to hang
  echo "[oaaa] quiescing USB before kexec..."
  for drv in xhci_hcd ehci-pci ohci-pci uhci_hcd; do
    drvpath="/sys/bus/pci/drivers/$drv"
    [ -d "$drvpath" ] || continue
    for d in "$drvpath"/????:??:??.?; do
      [ -d "$d" ] || continue
      addr=$(basename "$d")
      echo -n "$addr" > "$drvpath/unbind" 2>/dev/null && echo "[oaaa] unbound $drv $addr"
    done
  done
  kexec -e
  echo "[oaaa] FATAL: kexec -e returned"
  exec setsid cttyhack sh
fi
